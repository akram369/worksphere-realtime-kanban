{
  "name": "realtime-kanban-multi-tenant",
  "version": "1.0.0",
  "description": "Real-Time Collaborative Kanban Board (Multi-Organization + Multi-Tenant)",
  "scripts": {
    "build": "npm --prefix client run build",
    "prisma:generate": "npx --prefix server prisma generate --schema server/prisma/schema.prisma",
    "start": "node server/src/server.js",
    "server": "node server/src/server.js",
    "server:dev": "node --watch server/src/server.js",
    "client": "npm --prefix client run dev",
    "db:push": "npx --prefix server prisma db push --schema server/prisma/schema.prisma",
    "seed": "node server/src/db/seedPrisma.js",
    "test": "node server/tests/run-all-tests.js"
  },
  "keywords": [
    "kanban",
    "multi-tenant",
    "realtime",
    "websocket",
    "rbac",
    "postgresql",
    "neon"
  ],
  "author": "akram369",
  "license": "MIT"
}
